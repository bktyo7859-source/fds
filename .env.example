# -----------------------------------------------------------------------------
# HMX Real-Estate Intelligence Platform — Environment Configuration
# -----------------------------------------------------------------------------

# Google Maps JavaScript API Key
# Enables Google Maps satellite imagery, photorealistic 3D layers, and Google Places autocomplete.
# If omitted, HMX automatically falls back to the high-precision spatial enclaves map without error.
VITE_GOOGLE_MAPS_API_KEY=

# Backend API Base URL (leave blank for local Vite dev proxy to http://127.0.0.1:8000)
VITE_API_BASE_URL=
